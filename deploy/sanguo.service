[Unit]
Description=sanguo-graph Flask service
After=network.target neo4j.service

[Service]
Type=simple
User=sanguo
Group=sanguo
WorkingDirectory=/opt/sanguo-graph
EnvironmentFile=/opt/sanguo-graph/.env
ExecStart=/opt/sanguo-graph/venv/bin/gunicorn -c deploy/gunicorn.conf.py "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
